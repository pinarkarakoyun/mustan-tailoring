# Copy this file to .env.local and fill in real values.
# .env.local is ignored by Git and must never be committed.

# Password for the admin panel login (prototype: one shared password).
ADMIN_PASSWORD=change-me

# Secret used to sign the login cookie. At least 32 random characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public address of the website, used in QR codes and tracking links.
# Leave empty in development: the address you open the admin with is used.
SITE_URL=
